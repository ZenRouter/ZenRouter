{
  "name": "zenrouter-app",
  "version": "0.7.2",
  "description": "ZenRouter web dashboard & Serene AI Gateway",
  "private": true,
  "scripts": {
    "dev": "next dev --port 20128",
    "dev:webpack": "next dev --webpack --port 20128",
    "build": "next build --webpack",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "postbuild:bun": "node scripts/copy-standalone-assets.mjs",
    "start": "node custom-server.js --port 20128",
    "dev:bun": "bun --bun next dev --webpack --port 20128",
    "build:bun": "bun --bun next build --webpack",
    "start:bun": "bun ./.next/standalone/custom-server.js",
    "cli:pack": "npm --prefix cli run pack:cli",
    "cli:publish": "npm --prefix cli run publish:cli",
    "test": "npx vitest run --config tests/vitest.config.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.3.5",
    "@node-saml/node-saml": "^5.1.0",
    "@xyflow/react": "^12.11.6",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "confbox": "^0.2.4",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.7",
    "jose": "^6.2.12",
    "marked": "^18.0.13",
    "material-symbols": "^0.47.4",
    "monaco-editor": "^0.56.0",
    "next": "^16.3.5",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.4",
    "ora": "^9.1.0",
    "prop-types": "^15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^16.13.1",
    "recharts": "^3.7.0",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^8.0.5",
    "sql.js": "^1.14.1",
    "undici": "^7.29.1",
    "uuid": "^13.0.2",
    "zustand": "^5.0.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools — sql.js is used as fallback at runtime",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4"
  },
  "overrides": {
    "dompurify": "^3.4.14",
    "qs": "^6.16.0",
    "sharp": "^0.35.4",
    "js-yaml": "^4.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZenRouter/ZenRouter.git"
  }
}
